<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the cover fills the height on the left; text and controls share the right. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="12dp"
    tools:context=".NowPlayingActivity">

    <ImageView
        android:id="@+id/np_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/np_player"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_screen"
        android:src="@drawable/ic_np_player"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/np_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/colorText"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/np_cover"
        app:layout_constraintEnd_toStartOf="@id/np_player" />

    <TextView
        android:id="@+id/np_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/colorText"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/np_title"
        app:layout_constraintStart_toStartOf="@id/np_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/np_album"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/colorTextDim"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/np_artist"
        app:layout_constraintStart_toStartOf="@id/np_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/np_format"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/colorAccent"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/np_album"
        app:layout_constraintStart_toStartOf="@id/np_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/np_seek"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        app:layout_constraintBottom_toTopOf="@id/np_elapsed"
        app:layout_constraintStart_toStartOf="@id/np_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/np_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/colorTextDim"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/np_play_pause"
        app:layout_constraintStart_toStartOf="@id/np_title" />

    <TextView
        android:id="@+id/np_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/colorTextDim"
        android:textSize="13sp"
        app:layout_constraintBaseline_toBaselineOf="@id/np_elapsed"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/np_previous"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/previous_track"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:src="@drawable/ic_np_previous"
        app:layout_constraintBottom_toBottomOf="@id/np_play_pause"
        app:layout_constraintTop_toTopOf="@id/np_play_pause"
        app:layout_constraintEnd_toStartOf="@id/np_play_pause" />

    <ImageButton
        android:id="@+id/np_play_pause"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play_pause"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_np_play"
        app:tint="@color/colorAccent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/np_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/np_next"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/next_track"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:src="@drawable/ic_np_next"
        app:layout_constraintBottom_toBottomOf="@id/np_play_pause"
        app:layout_constraintTop_toTopOf="@id/np_play_pause"
        app:layout_constraintStart_toEndOf="@id/np_play_pause" />
</androidx.constraintlayout.widget.ConstraintLayout>
